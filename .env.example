# Copy sang .env rồi điền giá trị thật. Không commit .env chứa key thật.
DB_NAME=aivideo
DB_USER=aivideo
DB_PASSWORD=doi-mat-khau-manh-o-day

# Object storage (MinIO local / S3 prod)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=doi-mat-khau-manh-o-day
S3_BUCKET=aivideo
S3_URL_EXPIRY_HOURS=168

# Auth (bắt buộc >= 32 ký tự)
JWT_SECRET=dev-secret-change-me-please-32chars!
JWT_EXPIRY_HOURS=24

# AI LLM (OpenAI-compatible). Trống = task AI sẽ báo lỗi rõ ràng, task khác vẫn chạy.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=60

# TTS ElevenLabs giọng ADAM
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB
ELEVENLABS_MODEL=eleven_v3
TTS_TIMEOUT_SECONDS=120

# Upload & media binary
MAX_UPLOAD_MB=500
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
VIDEO_FONT_PATH=/System/Library/Fonts/Helvetica.ttc
